{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wispy-queen-f9b5",
  "main": "src/index.js",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "VIDEO_STATE",
        "class_name": "VideoStudioState"
      }
    ]
  },
  "exports": {
    "VideoStudioState": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
